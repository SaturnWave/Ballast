<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ballast.App.Views.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Ballast.App.Controls"
    xmlns:conv="using:Ballast.App.Converters"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
            One finding.

            Reading order is fixed and deliberate: what was noticed, the fact it was noticed from,
            why that is worth a look, and only then what you might do about it. Evidence before
            explanation matters — a user who disagrees with the reasoning can still see the raw
            observation and judge it themselves, which is the difference between a report and a
            verdict.
        -->
        <DataTemplate x:Key="SecurityFindingTemplate">
            <StackPanel>
                <Border Style="{StaticResource AppSeparator}" />
                <Grid Margin="20,14,20,16" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--
                        The severity rule, in the risk ramp: High -> Risk1, Medium -> Risk2,
                        Low -> Risk3, Info -> secondary ink because it is not on the ramp at all.

                        Four stacked bars with exactly one visible, rather than one bar with a
                        bound brush: a ThemeResource cannot be picked by a binding, and resolving
                        the brush in the view model instead would leave it stale when the theme is
                        switched from Settings. The band is also written out in the group heading
                        above, so nothing here is carried by colour alone.
                    -->
                    <Grid Grid.Column="0"
                          Width="3"
                          VerticalAlignment="Stretch"
                          AutomationProperties.AccessibilityView="Raw">
                        <Border CornerRadius="2"
                                Background="{ThemeResource Risk1Brush}"
                                Visibility="{Binding IsHigh, Converter={StaticResource BoolToVisibility}}" />
                        <Border CornerRadius="2"
                                Background="{ThemeResource Risk2Brush}"
                                Visibility="{Binding IsMedium, Converter={StaticResource BoolToVisibility}}" />
                        <Border CornerRadius="2"
                                Background="{ThemeResource Risk3Brush}"
                                Visibility="{Binding IsLow, Converter={StaticResource BoolToVisibility}}" />
                        <Border CornerRadius="2"
                                Background="{ThemeResource AppTextSecondaryBrush}"
                                Visibility="{Binding IsInfo, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Left" MaxWidth="620">

                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource TextBody}"
                                   TextWrapping="Wrap" />

                        <!-- The observed fact. Selectable, because this is the part worth copying. -->
                        <TextBlock Text="{Binding Evidence}"
                                   Style="{StaticResource TextCaption}"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{Binding Explanation}"
                                   Style="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />

                        <TextBlock Text="{Binding RecommendationText}"
                                   Style="{StaticResource TextSecondary}"
                                   Foreground="{ThemeResource AppTextBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasRecommendation, Converter={StaticResource BoolToVisibility}}" />

                        <!--
                            Every action here is either read-only or reversible. There is no
                            "remove", no "quarantine" and no "fix": Ballast reports, the user acts,
                            and the only thing that changes anything at all is the startup switch,
                            which moves the entry rather than deleting it.
                        -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    Margin="0,6,0,0">

                            <Button Content="Show in File Explorer"
                                    Style="{StaticResource AppGhostButton}"
                                    Command="{Binding RevealCommand}"
                                    Visibility="{Binding HasTargetPath, Converter={StaticResource BoolToVisibility}}" />

                            <Button Content="Ask Defender to check it"
                                    Style="{StaticResource AppGhostButton}"
                                    Command="{Binding ScanWithDefenderCommand}"
                                    ToolTipService.ToolTip="{Binding DefenderScanTooltip}"
                                    Visibility="{Binding HasTargetPath, Converter={StaticResource BoolToVisibility}}" />

                            <Button Content="Turn off this startup entry"
                                    Style="{StaticResource AppSecondaryButton}"
                                    Command="{Binding TurnOffStartupEntryCommand}"
                                    ToolTipService.ToolTip="{Binding TurnOffTooltip}"
                                    Visibility="{Binding CanTurnOffStartupEntry, Converter={StaticResource BoolToVisibility}}" />

                        </StackPanel>

                        <TextBlock Text="{Binding ActionNote}"
                                   Style="{StaticResource TextCaption}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding HasActionNote, Converter={StaticResource BoolToVisibility}}" />

                        <!-- The rule that produced this, so it can be found in "What was checked". -->
                        <TextBlock Text="{Binding RuleId}"
                                   Style="{StaticResource TextCaption}"
                                   Foreground="{ThemeResource AppTextTertiaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   Margin="0,4,0,0" />

                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- One severity band. The heading names the band in words. -->
        <DataTemplate x:Key="SecurityGroupTemplate">
            <controls:GroupedCard Header="{Binding Label}" Footer="{Binding CountText}">
                <ItemsControl ItemsSource="{Binding Findings}"
                              ItemTemplate="{StaticResource SecurityFindingTemplate}" />
            </controls:GroupedCard>
        </DataTemplate>

        <!-- One rule in the "What was checked" list: its name, and what it leaves alone. -->
        <DataTemplate x:Key="SecurityCheckTemplate">
            <StackPanel>
                <Border Style="{StaticResource AppSeparator}" />
                <StackPanel Margin="20,12,20,14" Spacing="4" HorizontalAlignment="Left" MaxWidth="620">
                    <TextBlock Text="{Binding Name}"
                               Style="{StaticResource TextBody}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Rationale}"
                               Style="{StaticResource TextSecondary}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RuleId}"
                               Style="{StaticResource TextCaption}"
                               Foreground="{ThemeResource AppTextTertiaryBrush}"
                               IsTextSelectionEnabled="True" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Margin="0,0,0,40">

            <TextBlock Text="Security"
                       Style="{StaticResource TextTitleLarge}"
                       Margin="32,24,32,6" />
            <TextBlock Text="Ballast is not an antivirus. It checks a few structural things an antivirus does not look at, and shows you what Windows reports about the program that does."
                       Style="{StaticResource TextSecondary}"
                       TextWrapping="Wrap"
                       MaxWidth="620"
                       HorizontalAlignment="Left"
                       Margin="32,0,32,32" />

            <!--
                ================= Your antivirus =================

                First on the page, before anything Ballast found itself, and that ordering is the
                whole argument: the real antivirus is the primary defence and this page is a second
                opinion. There is no shield and no tick anywhere in this card. Every line is
                something Windows was asked and answered, or an explicit "not known".
            -->
            <controls:GroupedCard Header="Your antivirus" Footer="{Binding AntivirusFootnote}">
                <StackPanel>

                    <StackPanel Margin="20,16,20,14" Spacing="6" HorizontalAlignment="Left" MaxWidth="620">
                        <TextBlock Text="{Binding AntivirusStateText}"
                                   Style="{StaticResource TextHeadline}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AntivirusStateNote}"
                                   Style="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasAntivirusStateNote, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <Border Style="{StaticResource AppSeparator}" />
                    <Grid Margin="20,12,20,12" ColumnSpacing="14" MinHeight="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Defender security intelligence"
                                   Style="{StaticResource TextBody}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SignatureText}"
                                   Style="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <Border Style="{StaticResource AppSeparator}" />
                    <Grid Margin="20,12,20,12" ColumnSpacing="14" MinHeight="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Defender's last scan"
                                   Style="{StaticResource TextBody}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LastScanText}"
                                   Style="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <!--
                        Shown only when Defender's history actually has something in it, and only as
                        a count. Restating Defender's findings in Ballast's words would be Ballast
                        claiming to interpret them; the honest move is to point at the tool that
                        owns the answer.
                    -->
                    <Border Style="{StaticResource AppSeparator}"
                            Visibility="{Binding HasRecentDetections, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding RecentDetectionsText}"
                               Style="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Left"
                               MaxWidth="620"
                               Margin="20,12,20,12"
                               Visibility="{Binding HasRecentDetections, Converter={StaticResource BoolToVisibility}}" />

                    <Border Style="{StaticResource AppSeparator}" />
                    <StackPanel Margin="20,14,20,16" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Run a quick scan"
                                    Style="{StaticResource AppSecondaryButton}"
                                    Command="{Binding RunQuickScanCommand}"
                                    ToolTipService.ToolTip="Asks Windows Defender to run its own quick scan. It runs in Defender and reports in Windows Security; Ballast does not see the result."
                                    MinWidth="150" />
                            <Button Content="Open Windows Security"
                                    Style="{StaticResource AppGhostButton}"
                                    Command="{Binding OpenWindowsSecurityCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding DefenderScanNote}"
                                   Style="{StaticResource TextCaption}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Left"
                                   MaxWidth="620"
                                   Visibility="{Binding HasDefenderScanNote, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                </StackPanel>
            </controls:GroupedCard>

            <Border Style="{StaticResource AppSeparatorFull}" Margin="32,28,32,28" />

            <!-- ================= Ballast's own checks ================= -->
            <Grid Margin="32,0,32,0" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Ballast's own checks" Style="{StaticResource TextHeadline}" />
                    <TextBlock Text="Structural checks on what starts with Windows and where it runs from."
                               Style="{StaticResource TextSecondary}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Run the checks"
                        Style="{StaticResource AppPrimaryButton}"
                        Command="{Binding RunChecksCommand}"
                        IsEnabled="{Binding IsIdle}"
                        MinWidth="128" />

                <Button Grid.Column="2"
                        Content="Stop"
                        Style="{StaticResource AppSecondaryButton}"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                        MinWidth="88" />
            </Grid>

            <StackPanel Margin="32,20,32,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar Style="{StaticResource AppProgressBar}"
                             Maximum="100"
                             Value="{Binding ProgressValue}"
                             IsIndeterminate="{Binding IsIndeterminate}" />
                <TextBlock Text="{Binding CurrentPath}"
                           Style="{StaticResource TextCaption}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,10,0,0" />
            </StackPanel>

            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource TextSecondary}"
                       TextWrapping="Wrap"
                       Margin="32,16,32,0" />

            <Border Style="{StaticResource AppSeparatorFull}" Margin="32,28,32,28" />

            <!-- ================= Findings, highest band first ================= -->
            <StackPanel Visibility="{Binding ShowFindings, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Groups}"
                              ItemTemplate="{StaticResource SecurityGroupTemplate}" />

                <TextBlock Text="{Binding FindingsFootnote}"
                           Style="{StaticResource TextSecondary}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Left"
                           MaxWidth="620"
                           Margin="32,4,32,0" />
            </StackPanel>

            <!--
                ================= Empty state =================

                No tick, no shield, no green. "Nothing unusual found" is the largest claim these
                checks can support, and the sentence under it exists so the page is never read as
                an all-clear from something that is not an antivirus.
            -->
            <Border Style="{StaticResource AppCard}"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Padding="24,40,24,40" Spacing="12" HorizontalAlignment="Center" MaxWidth="560">
                    <!--
                        A magnifier, not a tick. The other empty states in this app use a check
                        mark, and here that would be a reassurance these checks are not entitled to
                        give. This one says only "we looked", which is the true claim.
                    -->
                    <FontIcon FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE721;"
                              FontSize="22"
                              Foreground="{ThemeResource AppTextTertiaryBrush}" />
                    <TextBlock Text="{Binding EmptyStateTitle}"
                               Style="{StaticResource TextTitle}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <TextBlock Text="{Binding EmptyStateBody}"
                               Style="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ================= What was checked ================= -->
            <Button Style="{StaticResource AppGhostButton}"
                    Command="{Binding ToggleChecksCommand}"
                    HorizontalAlignment="Left"
                    Margin="32,28,32,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding ChecksToggleText}" />
                    <FontIcon FontFamily="Segoe Fluent Icons"
                              Glyph="{Binding ChecksGlyph}"
                              FontSize="12"
                              VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <StackPanel Margin="0,14,0,0"
                        Visibility="{Binding ChecksExpanded, Converter={StaticResource BoolToVisibility}}">
                <controls:GroupedCard Footer="{Binding ChecksFootnote}">
                    <ItemsControl ItemsSource="{Binding Checks}"
                                  ItemTemplate="{StaticResource SecurityCheckTemplate}" />
                </controls:GroupedCard>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
