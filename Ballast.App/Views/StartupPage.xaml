<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ballast.App.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Ballast.App.Controls"
    xmlns:conv="using:Ballast.App.Converters"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />

        <!-- One startup entry: icon, name, publisher + command, switch. -->
        <DataTemplate x:Key="StartupEntryTemplate">
            <StackPanel>
                <Border Style="{StaticResource AppSeparator}" />
                <Grid Margin="20,12,20,12" ColumnSpacing="14" MinHeight="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--
                        The program's own icon, with the source glyph underneath it. Both live in a
                        fixed 24px cell so the name column starts at the same x on every row,
                        whether or not an icon was found and whether or not it has arrived yet:
                        icons are loaded after the list is on screen, so the fallback is what shows
                        for the first instant of every scan.
                    -->
                    <Grid Grid.Column="0"
                          Width="24"
                          Height="24"
                          VerticalAlignment="Center"
                          AutomationProperties.AccessibilityView="Raw">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="{Binding Glyph}"
                                  FontSize="16"
                                  Foreground="{ThemeResource AppTextTertiaryBrush}"
                                  Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVisibility}}" />
                        <Image Source="{Binding Icon}"
                               Width="22"
                               Height="22"
                               Stretch="Uniform"
                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Name}"
                                   Style="{StaticResource TextBody}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SecondaryText}"
                                   Style="{StaticResource TextSecondary}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SourceLabel}"
                                   Style="{StaticResource TextCaption}"
                                   TextWrapping="NoWrap" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Style="{StaticResource AppPill}"
                            Visibility="{Binding ShowAdminNote, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding AdminNote}"
                                   FontFamily="Inter, Segoe UI Variable Text, Segoe UI"
                                   FontSize="12"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    </Border>

                    <!--
                        IsOn is bound ONE-WAY on purpose: it shows what the system currently does.
                        The change itself goes through Toggled -> StartupViewModel.ToggleAsync, so a
                        registry write that can fail is never hidden inside a property setter.
                    -->
                    <!--
                        Stock ToggleSwitch, styled by nothing. It keeps its "On"/"Off" label so
                        the state of each entry is unmistakable; see Controls.xaml for why the
                        two restyled attempts were dropped.
                    -->
                    <ToggleSwitch Grid.Column="3"
                                  VerticalAlignment="Center"
                                  IsOn="{Binding IsEnabled, Mode=OneWay}"
                                  IsEnabled="{Binding CanChange}"
                                  Toggled="OnEntryToggled" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Margin="0,0,0,40">

            <TextBlock Text="Startup"
                       Style="{StaticResource TextTitleLarge}"
                       Margin="32,24,32,6" />
            <TextBlock Text="Everything Windows launches when you sign in."
                       Style="{StaticResource TextSecondary}"
                       MaxWidth="560"
                       HorizontalAlignment="Left"
                       Margin="32,0,32,32" />

            <!-- Refresh + status, on the page rather than boxed. -->
            <Grid Margin="32,0,32,0" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Startup entries" Style="{StaticResource TextHeadline}" />
                    <TextBlock Text="{Binding ScheduledTaskNote}"
                               Style="{StaticResource TextSecondary}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Refresh"
                        Style="{StaticResource AppSecondaryButton}"
                        Command="{Binding LoadCommand}"
                        IsEnabled="{Binding IsIdle}"
                        MinWidth="112" />
            </Grid>

            <ProgressBar Style="{StaticResource AppProgressBar}"
                         IsIndeterminate="True"
                         Margin="32,20,32,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource TextSecondary}"
                       Margin="32,16,32,0" />

            <Border Style="{StaticResource AppSeparatorFull}" Margin="32,32,32,32" />

            <!-- ================= The list ================= -->
            <controls:GroupedCard Header="Launches with Windows"
                                  Footer="{Binding PageFootnote}"
                                  Visibility="{Binding Entries.Count, Converter={StaticResource CountToVisibility}}">
                <ItemsControl ItemsSource="{Binding Entries}"
                              ItemTemplate="{StaticResource StartupEntryTemplate}" />
            </controls:GroupedCard>

            <!-- ================= Empty state ================= -->
            <Border Style="{StaticResource AppCard}"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Padding="20,40,20,40" Spacing="10" HorizontalAlignment="Center">
                    <FontIcon FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE73E;"
                              FontSize="22"
                              Foreground="{ThemeResource AppTextTertiaryBrush}" />
                    <TextBlock Text="Nothing launches with Windows"
                               Style="{StaticResource TextTitle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Your sign-in is as fast as it gets."
                               Style="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
