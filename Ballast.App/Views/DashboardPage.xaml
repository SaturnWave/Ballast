<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ballast.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Ballast.App.Controls"
    xmlns:conv="using:Ballast.App.Converters"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Margin="0,0,0,40">

            <TextBlock Text="Ballast"
                       Style="{StaticResource TextTitleLarge}"
                       Margin="32,24,32,6" />
            <TextBlock Text="A quick look at what can be reclaimed. Nothing is removed until you confirm it."
                       Style="{StaticResource TextSecondary}"
                       MaxWidth="560"
                       HorizontalAlignment="Left"
                       Margin="32,0,32,36" />

            <!--
                The hero has no card around it. The single number this page exists to report
                sits directly on the page, at the largest size in the app, with the action it
                belongs to beside it - there is nothing else here to separate it from.
            -->
            <Grid Margin="32,0,32,0" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Reclaimable"
                               Style="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding JunkDisplay}"
                               Style="{StaticResource TextDisplay}"
                               Margin="0,4,0,2" />
                    <TextBlock Text="{Binding JunkSubtitle}"
                               Style="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding HeroCaption}"
                               Style="{StaticResource TextSecondary}"
                               MaxWidth="520"
                               HorizontalAlignment="Left"
                               Margin="0,14,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Spacing="8"
                            MinWidth="156">
                    <Button Content="Smart Scan"
                            Style="{StaticResource AppPrimaryButton}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding SmartScanCommand}"
                            IsEnabled="{Binding IsIdle}" />
                    <Button Content="Stop"
                            Style="{StaticResource AppSecondaryButton}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                            Margin="0,24,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar Style="{StaticResource AppProgressBar}"
                                 Maximum="100"
                                 Value="{Binding ProgressValue}"
                                 IsIndeterminate="{Binding IsIndeterminate}" />
                    <TextBlock Text="{Binding CurrentPath}"
                               Style="{StaticResource TextCaption}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource TextSecondary}"
                       Margin="32,16,32,0" />

            <!-- The only rule on the page: hero above, detail below. -->
            <Border Style="{StaticResource AppSeparatorFull}" Margin="32,36,32,36" />

            <!-- ================= Overview rows ================= -->
            <controls:GroupedCard Header="Overview"
                                  Footer="Open a row for the full picture.">
                <StackPanel>

                    <!-- Junk -->
                    <Button Style="{StaticResource AppRowButton}" Click="OnJunkRowClick">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Style="{StaticResource AppRowGlyph}"
                                      Glyph="&#xEA99;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Junk found" Style="{StaticResource TextBody}" />
                                <TextBlock Text="{Binding JunkSubtitle}" Style="{StaticResource TextCaption}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding JunkRowValue}"
                                       Style="{StaticResource TextBody}"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <FontIcon Grid.Column="3" Style="{StaticResource AppChevron}" />
                        </Grid>
                    </Button>

                    <Border Style="{StaticResource AppSeparator}" />

                    <!-- Drive -->
                    <Button Style="{StaticResource AppRowButton}" Click="OnDriveRowClick">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Style="{StaticResource AppRowGlyph}"
                                      Glyph="&#xEDA2;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <TextBlock Text="{Binding DriveName}" Style="{StaticResource TextBody}" />
                                <TextBlock Text="{Binding DriveSubtitle}" Style="{StaticResource TextCaption}" />
                                <ProgressBar Style="{StaticResource AppProgressBar}"
                                             Maximum="100"
                                             Value="{Binding DrivePercent}"
                                             Margin="0,3,16,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding DriveFreeDisplay}"
                                       Style="{StaticResource TextBody}"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <FontIcon Grid.Column="3" Style="{StaticResource AppChevron}" />
                        </Grid>
                    </Button>

                    <Border Style="{StaticResource AppSeparator}" />

                    <!-- Startup -->
                    <Button Style="{StaticResource AppRowButton}" Click="OnStartupRowClick">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Style="{StaticResource AppRowGlyph}"
                                      Glyph="&#xE945;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Startup items" Style="{StaticResource TextBody}" />
                                <TextBlock Text="{Binding StartupSubtitle}" Style="{StaticResource TextCaption}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding StartupCount}"
                                       Style="{StaticResource TextBody}"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <FontIcon Grid.Column="3" Style="{StaticResource AppChevron}" />
                        </Grid>
                    </Button>

                </StackPanel>
            </controls:GroupedCard>

            <!-- ================= Permissions ================= -->
            <controls:GroupedCard Header="Permissions"
                                  Footer="Ballast never elevates itself silently. Relaunch as administrator if you want system-wide caches included.">
                <Border Style="{StaticResource AppRow}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Style="{StaticResource AppRowGlyph}"
                                  Glyph="&#xE72E;" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ElevationNote}"
                                   Style="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </controls:GroupedCard>

        </StackPanel>
    </ScrollViewer>
</Page>
