<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ballast.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Ballast.App.Controls"
    xmlns:conv="using:Ballast.App.Converters"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="ThemeSegmentTemplate">
            <ToggleButton Style="{StaticResource AppSegmentButton}"
                          Content="{Binding Label}"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />
        </DataTemplate>

        <DataTemplate x:Key="AllowedRootTemplate">
            <TextBlock Text="{Binding}"
                       Style="{StaticResource TextCaption}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,3,0,3" />
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Margin="0,0,0,40">

            <TextBlock Text="Settings"
                       Style="{StaticResource TextTitleLarge}"
                       Margin="32,24,32,6" />
            <TextBlock Text="Appearance, diagnostics and what Ballast is allowed to touch."
                       Style="{StaticResource TextSecondary}"
                       MaxWidth="560"
                       HorizontalAlignment="Left"
                       Margin="32,0,32,36" />

            <!-- ================= Appearance ================= -->
            <controls:GroupedCard Header="Appearance"
                                  Footer="System follows the Windows light or dark setting.">
                <Grid Margin="20,14,20,14" ColumnSpacing="14" MinHeight="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Theme"
                               Style="{StaticResource TextBody}"
                               VerticalAlignment="Center" />

                    <Border Grid.Column="1" Style="{StaticResource AppSegmentTrack}">
                        <ItemsControl ItemsSource="{Binding ThemeOptions}"
                                      ItemTemplate="{StaticResource ThemeSegmentTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                </Grid>
            </controls:GroupedCard>

            <!-- ================= Diagnostics ================= -->
            <controls:GroupedCard Header="Diagnostics"
                                  Footer="{Binding StatusText}">
                <StackPanel>
                    <Button Style="{StaticResource AppRowButton}"
                            Command="{Binding OpenLogFolderCommand}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Style="{StaticResource AppRowGlyph}"
                                      Glyph="&#xE838;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Open log folder" Style="{StaticResource TextBody}" />
                                <TextBlock Text="{Binding LogFolder}"
                                           Style="{StaticResource TextCaption}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Style="{StaticResource AppChevron}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </controls:GroupedCard>

            <!-- ================= About ================= -->
            <controls:GroupedCard Header="About">
                <StackPanel>
                    <Grid Margin="20,12,20,12" ColumnSpacing="14" MinHeight="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ballast"
                                   Style="{StaticResource TextBody}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding VersionText}"
                                   Style="{StaticResource TextBody}"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource AppSeparator}" />

                    <Grid Margin="20,12,20,12" ColumnSpacing="14" MinHeight="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Running as"
                                   Style="{StaticResource TextBody}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ElevationText}"
                                   Style="{StaticResource TextBody}"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource AppSeparator}" />

                    <Grid Margin="20,12,20,12" ColumnSpacing="14" MinHeight="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Cleanup allowlist"
                                   Style="{StaticResource TextBody}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding AllowedRootsText}"
                                   Style="{StaticResource TextBody}"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </controls:GroupedCard>

            <!-- ================= The allowlist itself ================= -->
            <controls:GroupedCard Header="Locations Ballast may delete inside"
                                  Footer="{Binding SafetyFootnote}">
                <ItemsControl ItemsSource="{Binding AllowedRoots}"
                              ItemTemplate="{StaticResource AllowedRootTemplate}"
                              Margin="20,14,20,14" />
            </controls:GroupedCard>

        </StackPanel>
    </ScrollViewer>
</Page>
